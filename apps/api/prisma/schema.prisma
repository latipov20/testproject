// Vet Products: ma'lumotlar bazasi sxemasi.
// Narxlar so'mda, butun son (Int).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Do'konda faqat xaridor; backstage'da admin va kuryer.
enum Role {
  CUSTOMER
  COURIER
  ADMIN
}

enum Locale {
  uz
  ru
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StockMovementType {
  RECEIPT
  SALE
  RETURN
  WRITE_OFF
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PAYME
  CLICK
  CASH
}

enum PaymentState {
  PENDING
  PAID
  CANCELLED
  FAILED
}

enum CourierStatus {
  ACTIVE
  BUSY
  OFFLINE
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  RETURNED
}

// ---------- Foydalanuvchilar ----------

model User {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  name      String?
  locale    Locale   @default(uz)
  role      Role     @default(CUSTOMER)
  // Telegram bot orqali tasdiqlangan akkaunt: telefon raqam botdagi "raqamni yuborish" orqali olinadi.
  telegramId       BigInt? @unique
  telegramUsername String?
  // Admin paneliga faqat login/parol bilan kiriladi; superadmin boshqa adminlarni qo'shadi.
  login        String? @unique
  passwordHash String?
  superAdmin   Boolean @default(false)
  createdAt DateTime @default(now())

  addresses Address[]
  cartItems CartItem[]
  favorites Favorite[]
  orders    Order[]
  courier   Courier?
}

// Telegram orqali kirish: sayt token yaratadi, bot raqamni oladi va kod yuboradi, sayt kodni tekshiradi.
model TelegramLogin {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  chatId    BigInt?
  phone     String?
  firstName String?
  lastName  String?
  username  String?
  codeHash  String?
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([chatId, createdAt])
}

model Address {
  id       Int     @id @default(autoincrement())
  userId   Int
  zoneId   Int
  street   String
  landmark String?
  lat      Float?
  lng      Float?

  user   User         @relation(fields: [userId], references: [id])
  zone   DeliveryZone @relation(fields: [zoneId], references: [id])
  orders Order[]
}

// ---------- Katalog ----------

model Category {
  id       Int     @id @default(autoincrement())
  parentId Int?
  nameUz   String
  nameRu   String
  slug     String  @unique
  position Int     @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model AnimalType {
  id       Int       @id @default(autoincrement())
  nameUz   String
  nameRu   String
  slug     String    @unique
  products Product[]
}

model Product {
  id             Int           @id @default(autoincrement())
  categoryId     Int
  slug           String        @unique
  titleUz        String
  titleRu        String
  descriptionUz  String        @default("")
  descriptionRu  String        @default("")
  composition    String        @default("")
  dosageUz       String        @default("")
  dosageRu       String        @default("")
  manufacturer   String        @default("")
  registrationNo String?
  storageTemp    String?
  status         ProductStatus @default(DRAFT)
  // Bosh sahifadagi "Yangi" va "Trendda" bo'limlari uchun, admin qo'lda belgilaydi.
  isNew          Boolean       @default(false)
  isTrending     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category    Category         @relation(fields: [categoryId], references: [id])
  animalTypes AnimalType[]
  variants    ProductVariant[]
  images      ProductImage[]
  favorites   Favorite[]
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  sku       String  @unique
  packSize  String
  price     Int
  oldPrice  Int?
  active    Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches    Batch[]
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int
  url       String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ---------- Ombor ----------

// Qoldiq partiya (seriya) bo'yicha yuritiladi: har birining o'z yaroqlilik muddati bor.
model Batch {
  id            Int      @id @default(autoincrement())
  variantId     Int
  batchNo       String
  expiryDate    DateTime @db.Date
  qty           Int
  purchasePrice Int      @default(0)
  receivedAt    DateTime @default(now())

  variant    ProductVariant  @relation(fields: [variantId], references: [id])
  movements  StockMovement[]
  orderItems OrderItem[]

  @@unique([variantId, batchNo])
  @@index([variantId, expiryDate])
}

model StockMovement {
  id        Int               @id @default(autoincrement())
  batchId   Int
  type      StockMovementType
  qty       Int
  reason    String?
  userId    Int?
  orderId   Int?
  createdAt DateTime          @default(now())

  batch Batch @relation(fields: [batchId], references: [id])
}

// ---------- Savat ----------

model CartItem {
  id        Int @id @default(autoincrement())
  userId    Int
  variantId Int
  qty       Int

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
}

model Favorite {
  userId    Int
  productId Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

// ---------- Buyurtmalar ----------

model Order {
  id            Int           @id @default(autoincrement())
  userId        Int
  addressId     Int
  itemsTotal    Int
  deliveryFee   Int
  total         Int
  paymentMethod PaymentMethod
  status        OrderStatus   @default(NEW)
  comment       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  address  Address     @relation(fields: [addressId], references: [id])
  items    OrderItem[]
  payments Payment[]
  delivery Delivery?
}

// Narx, nom va partiya buyurtma paytida yozib qo'yiladi.
model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  variantId Int
  batchId   Int
  title     String
  price     Int
  qty       Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
  batch   Batch          @relation(fields: [batchId], references: [id])
}

model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int
  provider      PaymentMethod
  providerTxnId String?
  amount        Int
  state         PaymentState  @default(PENDING)
  raw           Json?
  createdAt     DateTime      @default(now())
  performedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  Int?

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, providerTxnId])
}

// ---------- Yetkazish ----------

model DeliveryZone {
  id       Int     @id @default(autoincrement())
  regionUz String
  regionRu String
  district String?
  fee      Int
  daysMin  Int
  daysMax  Int
  active   Boolean @default(true)

  addresses Address[]
  couriers  Courier[]
}

model Courier {
  id          Int           @id @default(autoincrement())
  userId      Int           @unique
  zoneId      Int?
  vehicleType String        @default("avto")
  status      CourierStatus @default(OFFLINE)
  // Shaxsiy ma'lumotlar (faqat adminlar ko'radi): pasport seriya+raqami va JSHSHIR (PINFL, 14 raqam).
  passport    String?
  pinfl       String?

  user       User            @relation(fields: [userId], references: [id])
  zone       DeliveryZone?   @relation(fields: [zoneId], references: [id])
  deliveries Delivery[]
  payouts    CourierPayout[]
}

model Delivery {
  id          Int            @id @default(autoincrement())
  orderId     Int            @unique
  courierId   Int
  fee         Int
  codAmount   Int            @default(0)
  cashTaken   Int?
  status      DeliveryStatus @default(ASSIGNED)
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime       @default(now())

  order   Order           @relation(fields: [orderId], references: [id])
  courier Courier         @relation(fields: [courierId], references: [id])
  events  DeliveryEvent[]
}

model DeliveryEvent {
  id         Int            @id @default(autoincrement())
  deliveryId Int
  status     DeliveryStatus
  lat        Float?
  lng        Float?
  photoUrl   String?
  createdAt  DateTime       @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model CourierPayout {
  id              Int      @id @default(autoincrement())
  courierId       Int
  periodStart     DateTime @db.Date
  periodEnd       DateTime @db.Date
  deliveriesCount Int
  amount          Int
  cashCollected   Int
  paid            Boolean  @default(false)

  courier Courier @relation(fields: [courierId], references: [id])
}

// ---------- Boshqa ----------

model Banner {
  id       Int     @id @default(autoincrement())
  titleUz  String
  titleRu  String
  imageUrl String
  link     String?
  position Int     @default(0)
  active   Boolean @default(true)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  entity    String
  entityId  Int?
  diff      Json?
  createdAt DateTime @default(now())
}
